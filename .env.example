# ===== 目标服务邮箱（收集问题的固定邮箱，必填）=====
TARGET_EMAIL=issues@example.com

# ===== SMTP 服务器配置 =====
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=your_smtp_user
SMTP_PASSWORD=your_smtp_password
# 使用 SSL（465）还是 STARTTLS（587 等）。true=SSL，false=STARTTLS
SMTP_USE_SSL=true

# ===== 发件人信息（可选，默认复用 SMTP_USERNAME）=====
SENDER_EMAIL=bot@example.com
SENDER_NAME=问题收集机器人

# ===== MCP 传输方式（可选）=====
# stdio：本机 stdio 模式，适合被本地 Agent 拉起
# streamable-http：远程客户端（如智齿）对配置的 URL 发 POST，端点填 MCP_PATH
# sse：旧版 GET /sse（智齿当前不是这种）
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/
